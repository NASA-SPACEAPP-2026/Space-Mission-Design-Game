    if (pl && pl.strn && pl.strn.risk && r() < pl.strn.risk) { f.alive = false; f.ended = true; f.cause = 'Aerofrenata: un passaggio troppo basso ha surriscaldato il satellite.'; at(0, f.cause, 'bad', 'strat'); return { f, log }; }
