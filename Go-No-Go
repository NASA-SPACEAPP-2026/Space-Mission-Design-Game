  const SPEC = { ion: 'Propulsione', sol: 'Batteria', tav: 'Computer', gyr: 'Assetto e navigazione', pho: 'Radio e comunicazioni', srl: 'Pannelli e generatori', grp: 'Robotica', lum: 'Payload', pix: 'Payload',
