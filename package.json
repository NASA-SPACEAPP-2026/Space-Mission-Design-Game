{
  "name": "space-mission-design-game",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "app/frontend",
    "app/backend"
  ],
  "scripts": {
    "build": "npm run build -w app/frontend && npm run build -w app/backend",
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"npm run dev -w app/frontend\" \"npm run dev -w app/backend\"",
    "dev:frontend": "npm run dev -w app/frontend",
    "dev:backend": "npm run dev -w app/backend",
    "start": "node app/backend/dist/index.js",
    "start:backend": "npm run start -w app/backend",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
