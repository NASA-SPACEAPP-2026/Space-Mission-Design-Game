{
  "name": "space-mission-design-game",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/gmat-up.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:seed-leaderboard": "node --env-file-if-exists=.env scripts/seed-leaderboard.mjs",
    "dev:api": "node --env-file-if-exists=.env --watch server.mjs",
    "dev": "vite",
    "build": "vite build && node scripts/build-game.mjs && node scripts/precompress.mjs",
    "preview": "vite preview",
    "start": "node server.mjs",
    "test": "vitest run --maxWorkers=2 --reporter=default --reporter=./scripts/test-table-reporter.mjs",
    "test:coverage": "vitest run --maxWorkers=2 --coverage --coverage.include=backend/** --coverage.include=server.mjs --coverage.include=scripts/gmat-bridge.mjs --coverage.reportsDirectory=test-results/coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "smoke": "node scripts/smoke.mjs",
    "smoke:account": "node scripts/smoke-account.mjs",
    "check": "npm test && npm run build && node scripts/verify-build.mjs",
    "package:azure": "./scripts/package-azure.sh release.zip",
    "package:single": "npm run build && node scripts/build-single-file.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.0",
    "vite": "^7.2.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
